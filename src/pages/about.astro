---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/_about.scss";
---

<BaseLayout
  title="About Kikos Hostel | Our Story & Team | Koh Phangan Thailand"
  description="Discover the Kiko’s story, meet our local team, and learn what makes Kiko’s a clean, social, and welcoming hostel in the heart of Koh Phangan."
>
  <div id="mobile-floating-nav" class="mobile-floating-nav">
    <a href="#about-story" class="float-nav-item">📖</a>
    <a href="#about-shine" class="float-nav-item">👨‍💼</a>
    <a href="#special" class="float-nav-item">🏠</a>
    <a href="#pro-tip" class="float-nav-item">💡</a>
  </div>

  <div id="about-container">
    <nav id="about-contents" class="about-nav">
      <ul class="nav-list">
        <li class="nav-item">
          <a href="#about-story" class="nav-link">Our Story</a>
          <ul class="sub-nav">
            <li>
              <a href="#about-story" class="sub-link">Introduction</a>
            </li>
            <li>
              <a href="#our-vibe" class="sub-link">Our Vibe</a>
            </li>
          </ul>
        </li>
        <li class="nav-item">
          <a href="#about-shine" class="nav-link">The owner</a>
          <ul class="sub-nav">
            <li>
              <a href="#about-shine" class="sub-link">Meet Shine</a>
            </li>
            <li>
              <a href="#shine-journey" class="sub-link">His Journey</a>
            </li>
          </ul>
        </li>
        <li class="nav-item">
          <a href="#special" class="nav-link">What Makes Us Special</a>
          <ul class="sub-nav">
            <li>
              <a href="#accommodation" class="sub-link">Accommodation</a>
            </li>
            <li><a href="#pro-tip" class="sub-link">Pro Tip</a></li>
          </ul>
        </li>
      </ul>
    </nav>

    <div id="about-content">
      <section id="about-story">
        <h1>The Kiko’s Story</h1>
        <p class="german">
          Kiko isn’t just our name - Kiko is a beloved dog who’s been part of
          our family since before our sister hostel “Wanderlust” even opened.
          She greeted backpackers, kept staff company during late-night paint
          jobs, and somehow managed to make everyone feel at home. When we
          created this space, we knew exactly what we wanted it to feel like:
          warm, friendly, and welcoming - just like Kiko.
        </p>
        <p>
          Kiko’s Hostel is our tribute to that spirit. We’re newly decorated,
          thoughtfully designed, and located a short walk from the main pier,
          Thong Sala Night Market, Phangan Food Court, Art Market, and the
          beach. Come for the comfort, stay for the community - and if you make
          it over to Wanderlust, say hi to the original Kiko for us :)
        </p>
        <img
          src="/compressed/hostel-pictures/outside.avif"
          alt="Kiko’s Hostel common areas"
        />

        <h2 id="our-vibe">Our Vibe</h2>
        <div class="vibe-cards">
          <div class="card">
            <h3>🌿 Calm & Social</h3>
            <p>
              We’re a clean, friendly, and social hostel - not a party spot.
              Expect relaxed hangs, new friends, and quiet hours for a great
              night’s sleep.
            </p>
          </div>
          <div class="card">
            <h3>🧘‍♀️ Balance is Key</h3>
            <p>
              Explore Koh Phangan’s wellness side: yoga, meditation, Thai
              massage, and peaceful beaches - with chill zones for every mood.
            </p>
          </div>
          <div class="card card-community">
            <h3>🤝 Community First</h3>
            <p>
              Connect with travelers from around the world and our local Thai
              team for authentic tips - from Muay Thai gyms to the best local
              food.
            </p>
          </div>
        </div>
      </section>

      <section id="about-shine">
        <div class="shine__image">
          <img src="/compressed/shine.avif " alt=" Founder portrait" />
        </div>
        <div class="shine__text">
          <h2>Shine: The Founder of Kiko’s</h2>
          <p>
            Meet Shine - the friendly force behind Kiko’s. With a passion for
            connection and community, Shine helped shape Kiko’s into a space
            that’s modern, welcoming, and full of heart. Whether sharing local
            tips or a good story, he makes guests feel right at home.
          </p>
          <h3 id="shine-journey">Shine’s Journey</h3>
          <p>✨ Built Kiko’s to bring people together in a relaxed setting</p>
          <p>🌱 Grew a community around comfort, cleanliness, and culture</p>
          <p>🌏 Loves connecting travelers with authentic local experiences</p>
          <p>💬 Known for warm hosting and great island recommendations</p>

          <p class="shine__quote">
            “Kiko reminds us that home is a feeling. If you leave with new
            friends and a full heart, we’ve done our job.”
          </p>
        </div>
      </section>

      <section id="special">
        <h2>What Makes Us Special</h2>

        <h3 id="accommodation">Accommodation Options</h3>
        <div class="cards">
          <div class="card card-1">
            <img
              src="/compressed/hostel-pictures/4bed.avif"
              alt="Modern dorms"
            />
            <h4>Modern Dorms</h4>
            <p>Privacy curtains, reading lights, outlets, key card access</p>
            <a href="/contact"><button class="btn btn--primary">Book</button></a
            >
          </div>

          <div class="card card-2">
            <img
              src="/compressed/hostel-pictures/corridor.avif"
              alt="Female-only dorms"
            />
            <h4>Female-Only Options</h4>
            <p>Comfortable, secure spaces (subject to availability)</p>
            <a href="/contact"><button class="btn btn--primary">Book</button></a
            >
          </div>

          <div class="card card-3">
            <img
              src="/compressed/hostel-pictures/commonArea.avif"
              alt="Common areas"
            />
            <h4>Spaces to Connect</h4>
            <p>
              Indoor lounge with Smart TV, outdoor terrace, and a communal
              kitchenette with microwave, big fridge, hot/cold water - plus free
              tea and coffee all day.
            </p>
            <a href="/contact"><button class="btn btn--primary">Book</button></a
            >
          </div>

          <div class="card">
            <h4>Location Advantage</h4>
            <p>
              Short walk to the pier, Night Market, Phangan Food Court, Art
              Market, and the beach - no scooter needed. Want to explore
              waterfalls and viewpoints? We’ll help arrange a reliable bike
              rental.
            </p>
          </div>

          <div id="pro-tip" class="card card-tip">
            <h4>Smart Timing</h4>
            <p>
              For calmer vibes and better rates, visit between Full Moon
              periods. During Full Moon, the island is busier and prices are
              higher.
            </p>
          </div>
        </div>
      </section>
      <!-- <div id="about-cta">
        <h2>Book your adventure!</h2>
        <button class="btn">Book Here!</button>
      </div> -->
    </div>
  </div>
</BaseLayout>

<script>
  // Highlight active section in floating nav
  const sections = ["about-story", "about-shine", "special", "pro-tip"];
  const floatNavItems = document.querySelectorAll(".float-nav-item");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const sectionId = entry.target.id;
          const index = sections.indexOf(sectionId);
          if (index !== -1) {
            floatNavItems.forEach((item) => item.classList.remove("active"));
            floatNavItems[index]?.classList.add("active");
          }
        }
      });
    },
    { threshold: 0.3 }
  );

  sections.forEach((id) => {
    const element = document.getElementById(id);
    if (element) observer.observe(element);
  });
</script>
