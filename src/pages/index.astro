  <!-- Load GSAP libraries deferred to avoid render delay -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer
  ></script>
  <script
    src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrambleTextPlugin.min.js"
    defer></script>
  <script
    src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"
    defer></script>

  <!-- Idle-load animations to let LCP paint first -->
  <script is:inline>
    function onIdle(fn) {
      if ("requestIdleCallback" in window) {
        requestIdleCallback(fn, { timeout: 2000 });
      } else {
        setTimeout(fn, 0);
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      // Hero title scramble animation (idle)
      onIdle(() => {
        if (!window.gsap || !window.ScrambleTextPlugin) return;

        gsap.registerPlugin(ScrambleTextPlugin);

        const texts = [
          // "ยินดีต้อนรับสู่สวรรค์!",
          "Willkommen im Paradies!",
          // "Chào mừng đến với Thiên đường!",
          "Welkom in het paradijs!",
          "Welcome to Paradise!",
          // "Cennete hoş geldiniz!",
          "Bienvenidos al paraíso!",
          "Bienvenue au paradis!",
          // "स्वर्ग में आपका स्वागत है",
          // "欢迎来到天堂!",
        ];

        const title = document.querySelector(".hero__title");
        if (!title) return;

        let lastIndex = -1;
        function getRandomText() {
          let i;
          do {
            i = Math.floor(Math.random() * texts.length);
          } while (i === lastIndex && texts.length > 1);
          lastIndex = i;
          return texts[i];
        }

        function animateRandomText() {
          const randomText = getRandomText();
          gsap
            .timeline({
              onComplete: () => setTimeout(animateRandomText, 1000),
            })
            .to(title, {
              duration: 5,
              scrambleText: {
                text: randomText,
                chars: "🐶🐾",
                // tweenLength: true,
                speed: 0.01,
              },
            });
        }

        // Start shortly after first paint
        setTimeout(animateRandomText, 100);
      });

      // Replace scroll-blur loop with IntersectionObserver for performance
      onIdle(() => {
        const cards = document.querySelectorAll(".why-us__card");
        if (!("IntersectionObserver" in window) || cards.length === 0) return;

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.style.filter = entry.isIntersecting
                ? "blur(0px)"
                : "blur(8px)";
            });
          },
          { root: null, threshold: 0.25 }
        );

        cards.forEach((c) => io.observe(c));
      });

      // Parallax: attach after idle and respect reduced motion
      onIdle(() => {
        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        if (prefersReducedMotion) return;

        const heroSection = document.getElementById("hero");
        if (!heroSection) return;

        const imageContainer = heroSection.querySelector(".image-container");
        const heroContent = heroSection.querySelector(".hero__content");

        let ticking = false;

        function updateParallax() {
          const scrolled = window.pageYOffset;
          const heroHeight = heroSection.offsetHeight;

          if (scrolled < heroHeight) {
            if (imageContainer) {
              const imageSpeed = scrolled * 0.4;
              imageContainer.style.transform = `translate3d(0, ${imageSpeed}px, 0)`;
            }
            if (heroContent) {
              const contentSpeed = scrolled * 0.2;
              heroContent.style.transform = `translate3d(0, ${contentSpeed}px, 0)`;
            }
          }
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => {
              updateParallax();
              ticking = false;
            });
            ticking = true;
          }
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        updateParallax();
      });
    });
  </script>
</BaseLayout>
