---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/_home.scss";
// Use only what's needed (CldImage removed to reduce JS)
import { Image } from "astro:assets";
---

<BaseLayout
  title="Kiko's Hostel Koh Phangan | Best Social Hostel Thailand | Full Moon Party"
  description="#1 rated social hostel in Koh Phangan! 5 minutes from Thongsala Pier, clean AC dorms, modern social vibe. Perfect base for Full Moon Party & island exploration. Book direct!"
>
  <!-- Performance hints in head via BaseLayout slots (preconnect + preload LCP) -->
  <fragment slot="head">
    <!-- Preconnects for faster third-party fetch -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="//cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="//res.cloudinary.com" />

    <!-- Preload the LCP hero image -->
    <link
      rel="preload"
      as="image"
      href="/compressed/shoreline.avif"
      type="image/avif"
      fetchpriority="high"
    />
  </fragment>

  <div id="home-container">
    <section id="hero">
      <div class="image-container">
        <img
          src="/compressed/shoreline.avif"
          width="1920"
          height="1080"
          alt="Koh Phangan shoreline view near Thong Sala"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="hero__content">
        <p class="hero__rating">Social but not a party hostel</p>
        <h1 class="hero__title">Welcome to Paradise, Fellow Wanderers! 🏝️</h1>
        <p class="hero__description">
          A short walk from Thong Sala Pier, Night Market, Phangan Food Court,
          Art Market, and the beach - Kiko’s Hostel is the perfect base to
          explore the island, no scooter needed.
        </p>
        <p class="hero__card">Comfort. Cleanliness. Community.</p>
        <div class="hero__cta">
          <h2>Ready for good vibes and new friendships?</h2>
          <a href="https://www.booking.com/Share-athlvM">
            <button class="hero__cta-btn btn btn--accent">
              Book your bed now
            </button>
          </a>
        </div>
      </div>
    </section>

    <section id="why-us">
      <h2>Why Choose Kiko’s?</h2>
      <div class="why-us__cards">
        <div class="why-us__card">
          <h3>🌊 Perfect Location</h3>
          <p>
            Walk to the pier, markets, and the beach. The island at your
            doorstep.
          </p>
        </div>
        <div class="why-us__card">
          <h3>🧑‍🤝‍🧑 Social, Not a Party Hostel</h3>
          <p>
            Friendly, welcoming atmosphere to meet travelers — quiet after hours
            for great sleep.
          </p>
        </div>
        <div class="why-us__card">
          <h3>🛏️ Modern Comfort</h3>
          <p>
            Newly decorated dorms with privacy curtains, reading lights, key
            card access, and A/C.
          </p>
        </div>
        <div class="why-us__card">
          <h3>☕ Easy Essentials</h3>
          <p>
            Indoor lounge with Smart TV, outdoor terrace, and a communal
            kitchenette (microwave, big fridge, hot/cold water) plus free tea
            and coffee all day.
          </p>
        </div>
      </div>
    </section>

