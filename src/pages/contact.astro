---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/_contact.scss";
---

<BaseLayout
  title="Contact Kiko's Hostel Koh Phangan | Book Direct | Volunteer Opportunities"
  description="Contact Kiko's Hostel directly for bookings, questions, or volunteer opportunities. Located 99/78 moo1 Thong Sala Koh Phangan 84280. Call +66 97 223 8054 or book online."
>
  <div id="contact-container">
    <section id="contact-hero">
      <div class="contact-hero__content">
        <h1>Get in Touch! 🏝️</h1>
        <p class="hero-subtitle">
          Ready to start your Koh Phangan adventure as a guest or volunteer?
          We're here to help!
        </p>
        <p id="discount" class="hero-subtitle discount">
          Book through us and get 10% off!
        </p>
      </div>
    </section>

    <section id="contact-main">
      <div class="contact-grid">
        <div class="contact-form-section">
          <h2>Send us a Message</h2>
          <form class="contact-form">
            <div class="form-group">
              <label for="name">Name *</label>
              <input type="text" id="name" name="name" required />
            </div>

            <div class="form-group">
              <label for="email">Email *</label>
              <input type="email" id="email" name="email" required />
            </div>

            <div class="form-group">
              <label for="dates">Travel Dates</label>
              <input
                type="text"
                id="dates"
                name="dates"
                placeholder="When are you visiting?"
              />
            </div>

            <div class="form-group">
              <label for="guests">Number of Guests</label>
              <select id="guests" name="guests">
                <option value="1">1 Guest</option>
                <option value="2">2 Guests</option>
                <option value="3">3 Guests</option>
                <option value="4">4+ Guests</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Tell us about your plans, questions, or special requests..."
              ></textarea>
            </div>

            <button type="submit" class="btn">Send Message 🚀</button>
          </form>
        </div>

        <div class="contact-info-section">
          <div class="contact-card">
            <h3>📍 Find Us</h3>
            <p>
              99/78 moo1 Thong Sala Koh Phangan,
              <br /> Surat Thani, Thailand 84280<br />
            </p>
            <iframe
              style="border:0"
              loading="lazy"
              allowfullscreen
              src="https://www.google.com/maps/embed/v1/view?zoom=17&center=9.7083%2C99.9944&key=AIzaSyAOl5QxvygrO8AtpeqREZtZv6zUPotsPKw"
            ></iframe>
          </div>

          <div class="contact-card">
            <h3>📞 Call Us</h3>
            <p>
              +66 97 223 8054<br />
              Available 24/7 for emergencies
            </p>
          </div>

          <div class="contact-card">
            <h3>✉️ Email Us</h3>
            <p>info@kikoshostel.com</p>
          </div>

          <div class="contact-card">
            <h3>🕒 Reception Hours (9am to 10pm)</h3>
            <p>
              <!-- ✓ Check-in from 14:00 to 22:00<br />
              ✓ Check-out until 12:00<br /> -->
              <em>
                <br />
                If you'd like to request an early or late check-in or check-out,
                you can email us<br />
              </em>
              <br />
              <strong>
                Please note that special requests cannot be guaranteed. If early
                or late check-in or check-out is essential to your travel plans,
                we recommend checking the cancellation options before you book.
              </strong>
            </p>
          </div>

          <!-- <div class="contact-card social-card">
            <h3>🌐 Follow Us</h3>
            <div class="social-links">
              <a
                href="https://www.instagram.com/Kikoskohphangan/"
                class="social-link">📷 Instagram</a
              >
            </div>
          </div> -->
        </div>
      </div>
    </section>
    <section id="contact-cta">
      <div class="cta-content">
        <h2>Ready to Book? 🎉</h2>
        <p>Skip the form and book directly through our partners!</p>
        <div class="cta-buttons">
          <a
            href="https://www.booking.com/Share-mpjb3kT"
            class="btn btn--primary">Booking.com</a
          >
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
